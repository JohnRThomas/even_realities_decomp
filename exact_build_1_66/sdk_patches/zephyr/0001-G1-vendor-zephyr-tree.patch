+int bt_hci_cmd_send_sync_timeout(uint16_t opcode, struct net_buf *buf, struct net_buf **rsp,
+				 int32_t timeout_ms, bool assert_on_timeout)
+{
+	struct k_sem sync_sem;
+	uint8_t status;
+	int err;
+
+	if (!buf) {
+		buf = bt_hci_cmd_create(opcode, 0);
+		if (!buf) {
+			return -ENOBUFS;
+		}
+	}
+
+	LOG_DBG("buf %p opcode 0x%04x len %u", buf, opcode, buf->len);
+
+	k_sem_init(&sync_sem, 0, 1);
+	cmd(buf)->sync = &sync_sem;
+
+	net_buf_put(&bt_dev.cmd_tx_queue, net_buf_ref(buf));
+
+	err = k_sem_take(&sync_sem, K_MSEC(timeout_ms));
+	if (assert_on_timeout) {
+		BT_ASSERT_MSG(err == 0, "command opcode 0x%04x timeout with err %d", opcode, err);
+	} else if (err) {
+		LOG_ERR("command opcode 0x%04x timeout with err %d", opcode, err);
+		return -ETIMEDOUT;
+	}
+
+	/*
+	 * Vendor variant of bt_hci_cmd_send_sync() with a caller-chosen timeout.
+	 * The assert above is on line 390 and the function is 59 lines long: the
+	 * line numbers of the asserts further down (573, ...) depend on it.
+	 */
+	status = cmd(buf)->status;
+	if (status) {
+		LOG_WRN("opcode 0x%04x status 0x%02x", opcode, status);
+		net_buf_unref(buf);
+
+		switch (status) {
+		case BT_HCI_ERR_CONN_LIMIT_EXCEEDED:
+			return -ECONNREFUSED;
+		case BT_HCI_ERR_INSUFFICIENT_RESOURCES:
+			return -ENOMEM;
+		default:
+			return -EIO;
+		}
+	}
+
+	LOG_DBG("rsp %p opcode 0x%04x len %u", buf, opcode, buf->len);
+
+	if (rsp) {
+		*rsp = buf;
+	} else {
+		net_buf_unref(buf);
+	}
+
+	return 0;
+}

From c2675d8ca332ecc4f05e7265988c2f866534ed90 Mon Sep 17 00:00:00 2001
From: G1 repro <johnrthomas27@gmail.com>
Date: Sun, 18 Oct 2026 15:44:30 -0700
Subject: [PATCH 1/3] G1 vendor: bt conn.c changes (L2 default security,
 set_security early return disabled)

---
 subsys/bluetooth/host/conn.c | 12 +++++-------
 1 file changed, 5 insertions(+), 7 deletions(-)

diff --git a/subsys/bluetooth/host/conn.c b/subsys/bluetooth/host/conn.c
index 155b1a041a0..ca542a2ba29 100644
--- a/subsys/bluetooth/host/conn.c
+++ b/subsys/bluetooth/host/conn.c
@@ -824,7 +824,6 @@ static int conn_prepare_events(struct bt_conn *conn,
 		return -ENOTCONN;
 	}
 
-	LOG_DBG("Adding conn %p to poll list", conn);
 
 	/* ISO Synchronized Receiver only builds do not transmit and hence
 	 * may not have any tx buffers allocated in a Controller.
@@ -865,7 +864,6 @@ int bt_conn_prepare_events(struct k_poll_event events[])
 	int i, ev_count = 0;
 	struct bt_conn *conn;
 
-	LOG_DBG("");
 
 	k_poll_signal_init(&conn_change);
 
@@ -2299,9 +2297,9 @@ int bt_conn_set_security(struct bt_conn *conn, bt_security_t sec)
 	}
 
 	/* nothing to do */
-	if (conn->sec_level >= sec || conn->required_sec_level >= sec) {
-		return 0;
-	}
+	//if (conn->sec_level >= sec || conn->required_sec_level >= sec) {
+	//	return 0;
+	//}
 
 	atomic_set_bit_to(conn->flags, BT_CONN_FORCE_PAIR,
 			  sec & BT_SECURITY_FORCE_PAIR);
@@ -2365,8 +2363,8 @@ struct bt_conn *bt_conn_add_le(uint8_t id, const bt_addr_le_t *peer)
 	conn->id = id;
 	bt_addr_le_copy(&conn->le.dst, peer);
 #if defined(CONFIG_BT_SMP)
-	conn->sec_level = BT_SECURITY_L1;
-	conn->required_sec_level = BT_SECURITY_L1;
+	conn->sec_level = BT_SECURITY_L2;
+	conn->required_sec_level = BT_SECURITY_L2;
 #endif /* CONFIG_BT_SMP */
 	conn->type = BT_CONN_TYPE_LE;
 	conn->le.interval_min = BT_GAP_INIT_CONN_INT_MIN;
-- 
2.56.0


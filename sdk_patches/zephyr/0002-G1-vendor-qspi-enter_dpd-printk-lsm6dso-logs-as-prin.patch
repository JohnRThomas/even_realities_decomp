-	LOG_DBG("accel pm is %d", cfg->accel_pm);
+	printk("accel pm is %d\r\n", cfg->accel_pm);
 	switch (cfg->accel_pm) {
 	default:
 	case 0:
@@ -779,23 +779,23 @@ static int lsm6dso_init_chip(const struct device *dev)
 	}
 

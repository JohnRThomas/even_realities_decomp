-		LOG_DBG("Disable shub before reset");
+		printk("Disable shub before reset\r\n");
 		lsm6dso_sh_master_set(ctx, 0);
 		k_busy_wait(300);
 	}
@@ -764,7 +764,7 @@ static int lsm6dso_init_chip(const struct device *dev)
 	k_busy_wait(100);
 

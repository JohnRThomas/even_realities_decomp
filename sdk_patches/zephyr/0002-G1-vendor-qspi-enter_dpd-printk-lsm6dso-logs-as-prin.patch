-		LOG_ERR("failed to set accelerometer odr %d", odr);
+		printk("failed to set accelerometer odr %d\r\n", odr);
 		return -EIO;
 	}
 
 	/* set gyro power mode */
-	LOG_DBG("gyro pm is %d", cfg->gyro_pm);
+	printk("gyro pm is %d\r\n", cfg->gyro_pm);
 	switch (cfg->gyro_pm) {
 	default:
 	case 0:
@@ -807,29 +807,29 @@ static int lsm6dso_init_chip(const struct device *dev)
 	}
 
 	fs = cfg->gyro_range;
-	LOG_DBG("gyro range is %d", fs);

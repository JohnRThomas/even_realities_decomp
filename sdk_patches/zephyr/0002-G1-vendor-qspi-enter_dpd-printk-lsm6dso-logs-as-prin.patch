From fc59b390d25fe56387f4de918a78996d509be6f8 Mon Sep 17 00:00:00 2001
From: G1 repro <johnrthomas27@gmail.com>
Date: Sun, 18 Oct 2026 15:46:23 -0700
Subject: [PATCH 2/3] G1 vendor: qspi enter_dpd printk, lsm6dso logs as printk

---
 drivers/flash/nrf_qspi_nor.c     |  1 +
 drivers/sensor/lsm6dso/lsm6dso.c | 86 ++++++++++++++++----------------
 2 files changed, 44 insertions(+), 43 deletions(-)

diff --git a/drivers/flash/nrf_qspi_nor.c b/drivers/flash/nrf_qspi_nor.c
index c373a2c8ab7..add6b02815c 100644
--- a/drivers/flash/nrf_qspi_nor.c
+++ b/drivers/flash/nrf_qspi_nor.c
@@ -1319,6 +1319,7 @@ static int enter_dpd(const struct device *const dev)
 		uint32_t t_enter_dpd = DT_INST_PROP_OR(0, t_enter_dpd, 0);
 		int ret;
 
+		printk("#############################enter_dpd\r\n");
 		ret = qspi_send_cmd(dev, &cmd, false);
 		if (ret < 0) {
 			return ret;
diff --git a/drivers/sensor/lsm6dso/lsm6dso.c b/drivers/sensor/lsm6dso/lsm6dso.c
